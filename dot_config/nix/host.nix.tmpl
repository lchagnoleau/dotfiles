# Machine-specific values, generated by chezmoi.
{{- $arch := .chezmoi.arch }}
{{- if eq $arch "arm64" }}{{ $arch = "aarch64" }}{{ else if eq $arch "amd64" }}{{ $arch = "x86_64" }}{{ end }}
{
  username = "{{ .chezmoi.username }}";
  homeDirectory = "{{ .chezmoi.homeDir }}";
  hostname = "{{ .chezmoi.hostname }}";
  system = "{{ $arch }}-{{ .chezmoi.os }}";
}
