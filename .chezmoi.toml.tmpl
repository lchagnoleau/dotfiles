{{- $isWork := promptBoolOnce . "isWork" "Is this a work machine" -}}
{{- $theme := promptChoiceOnce . "theme" "Color theme" (list "tokyonight" "carbonfox") -}}
[data]
    isWork = {{ $isWork }}
    theme = {{ $theme | quote }}
{{- if $isWork }}
    email_pro = {{ promptStringOnce . "email_pro" "Work email address" | quote }}
{{- end }}
    font_size = {{ promptStringOnce . "font_size" "Font size for Ghostty" | quote }}
