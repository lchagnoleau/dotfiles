# ── History ───────────────────────────────────────────────────────────────────
setopt inc_append_history
setopt share_history
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_reduce_blanks

# ── Plugin Manager (antidote) ──────────────────────────────────────────────────
zstyle ':plugin:ez-compinit' 'compstyle' 'zshzoo'
source $HOME/.antidote/antidote.zsh
antidote load
fpath=("$ZSH_CACHE_DIR/completions" $fpath)

# ── Key Bindings ──────────────────────────────────────────────────────────────
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
export HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND="fg=red"

# ── Aliases ───────────────────────────────────────────────────────────────────
export eza_params=(--icons --group --group-directories-first --time-style=long-iso)

alias l='eza --all --header --long $eza_params'
alias v='nvim'
alias g='git'
alias nproc='sysctl -n hw.physicalcpu'
alias cd='z'
alias rpodman='podman run -it --rm --arch x86_64 -v $PWD:$PWD -v $HOME/.ssh:/root/.ssh -w $PWD'

# ── FZF ───────────────────────────────────────────────────────────────────────
source <(fzf --zsh)

export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"

export FZF_CTRL_T_OPTS="--preview '$show_file_or_dir_preview'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} | head -200'"

# ── Prompt ────────────────────────────────────────────────────────────────────
eval "$(starship init zsh)"

# ── Zoxide ────────────────────────────────────────────────────────────────────
eval "$(zoxide init zsh)"

# ── Mise ──────────────────────────────────────────────────────────────────────
eval "$(mise activate zsh)"

# ── Fnox ──────────────────────────────────────────────────────────────────────
eval "$(fnox activate zsh)"

# ── Jujutsu (jj) completion ───────────────────────────────────────────────────
source <(COMPLETE=zsh jj)

# ── pay-respects ──────────────────────────────────────────────────────────────
eval "$(pay-respects zsh --alias)"

# ── atuin ─────────────────────────────────────────────────────────────────────
eval "$(atuin init zsh)"
